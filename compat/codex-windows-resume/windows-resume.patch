+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn windows_cwd_filters_match_verbatim_drive_and_unc_without_broadening_scope()
+-> anyhow::Result<()> {
+    let pool = sqlx::SqlitePool::connect("sqlite::memory:").await?;
+    sqlx::query("CREATE TABLE threads (cwd TEXT, archived INTEGER, preview TEXT)")
+        .execute(&pool)
+        .await?;
+    for (stored, filter) in [
+        (r"\\?\E:\Workspaces\Demo", r"e:\workspaces\demo\"),
+        (r"E:\Workspaces\Demo", r"\\?\E:\Workspaces\Demo"),
+        (r"\\?\UNC\server\share\Demo", r"\\server\share\Demo"),
+    ] {
+        sqlx::query("DELETE FROM threads").execute(&pool).await?;
+        sqlx::query(
+            "INSERT INTO threads VALUES (?, 0, 'message'), ('E:/Workspaces/Other', 0, 'message')",
+        )
+        .bind(stored)
+        .execute(&pool)
+        .await?;
+        let filters = vec![PathBuf::from(filter)];
+        let mut builder = QueryBuilder::<Sqlite>::new("SELECT cwd FROM threads");
+        push_thread_filters(
+            &mut builder,
+            ThreadFilterOptions {
+                archived_only: false,
+                allowed_sources: &[],
+                model_providers: None,
+                cwd_filters: Some(&filters),
+                section: None,
+                project_id: None,
+                anchor: None,
+                sort_key: SortKey::UpdatedAt,
+                sort_direction: SortDirection::Desc,
+                search_term: None,
+            },
+            /*include_thread_id_tiebreaker*/ false,
+        );
+        let actual: Vec<String> = builder.build_query_scalar().fetch_all(&pool).await?;
+        assert_eq!(actual, vec![stored.to_string()]);
+    }
+    Ok(())
+}
