diff --git a/codex-rs/tui/src/resume_picker_windows_tests.rs b/codex-rs/tui/src/resume_picker_windows_tests.rs
new file mode 100644
index 0000000000..6f8009c495
--- /dev/null
+++ b/codex-rs/tui/src/resume_picker_windows_tests.rs
@@ -0,0 +1,31 @@
+use super::*;
+use crate::legacy_core::config::ConfigBuilder;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn windows_picker_keeps_project_scope_when_runtime_provider_changes() {
+    let home = tempfile::tempdir().expect("home");
+    let mut config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .build()
+        .await
+        .expect("config");
+    config.model_provider_id = "different-router".to_string();
+    let params = thread_list_params(
+        /*cursor*/ None,
+        Some(Path::new(r"E:\Workspaces\Demo")),
+        SessionStatus::Active,
+        picker_provider_filter(&config, /*uses_remote_workspace*/ false),
+        ThreadSortKey::UpdatedAt,
+        /*include_non_interactive*/ false,
+        /*use_state_db_only*/ true,
+    );
+    assert_eq!(
+        (params.cwd, params.model_providers, config.model_provider_id),
+        (
+            Some(ThreadListCwdFilter::One(r"E:\Workspaces\Demo".to_string())),
+            Some(Vec::new()),
+            "different-router".to_string(),
+        )
+    );
+}
